// sdkgen keeps this repo's Rust IntentGoalType enum in lock-step with the node's
// goal vocabulary (../../goal-vocabulary.json, generated by infrix-core). The
// infrix-schema require below is the published FLOOR: every goal that release
// declares must be in that vocabulary. It is a dev/CI-only tool module (the
// crates themselves are pure Rust).
module github.com/opendlt/infrix-crates/tools/sdkgen

go 1.25.7

require github.com/opendlt/infrix-schema v0.7.1
